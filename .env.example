# Copy to .env and fill in what you need. Every setting is optional on your own computer.

# The public address, for share links, preview images and the calendar feed.
SITE_URL=http://localhost:3000

# Behind a reverse proxy (Caddy, Cloudflare, a host's load balancer): one per proxy that appends to
# X-Forwarded-For, so rate limits key on real client addresses. Leave at 0 with nothing in front.
# The live site uses 2: Cloudflare, then Caddy trusting Cloudflare's addresses (deploy/Caddyfile).
TRUST_PROXY_HOPS=0

# Background alerts (Web Push). Left empty, a key pair is made on first use and kept in .cache/push-vapid.json.
# Changing them later means every browser has to turn alerts on again. Never commit a real private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Where security researchers can reach you (mailto: or https:), served at /.well-known/security.txt.
# Nothing is published without it.
SECURITY_CONTACT=

# npm run serve: the address and port to listen on. 127.0.0.1 keeps it on this computer.
HOST=127.0.0.1
PORT=3000
