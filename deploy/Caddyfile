# Caddy: HTTPS for the site (certificates from Let's Encrypt, renewed on their own) in front of the app,
# which listens on this server only (127.0.0.1:3000). setup-server.sh puts this in /etc/caddy/Caddyfile.
{
	servers {
		# Cloudflare's own addresses (setup-server.sh fills them in from cloudflare.com/ips): a request
		# through Cloudflare keeps the visitor's address in X-Forwarded-For, and Caddy adds Cloudflare's
		# after it. Anyone else's X-Forwarded-For is thrown away and replaced with their real address.
		trusted_proxies static __CLOUDFLARE_RANGES__
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		# A slow or stalled upload can't hold a connection open (the app also caps bodies itself).
		timeouts {
			read_header 10s
			read_body 15s
			idle 2m
		}
	}
	# Certificates are proven over port 80 only. Behind Cloudflare, the firewall lets only Cloudflare reach
	# port 443 (firewall.sh), so Let's Encrypt's check over 443 could never get through.
	cert_issuer acme {
		disable_tlsalpn_challenge
	}
}

# Responses don't say what software the server runs ("Via: 1.1 Caddy", "Server: Caddy").
(quiet) {
	header {
		-Via
		-Server
	}
}

shadowcrypts.com {
	import quiet
	request_body {
		max_size 64KB
	}
	reverse_proxy 127.0.0.1:3000
}

# One address for search engines: www goes to the plain one.
www.shadowcrypts.com {
	import quiet
	redir https://shadowcrypts.com{uri} permanent
}
